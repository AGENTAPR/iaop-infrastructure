# ==============================================================================
# IAOP Self-Hosted DEV Environment Template
# Copy to .env and customize for local host environment
# Target Host: AMD Ryzen 5, 16 GB RAM, 256 GB NVMe SSD
# ==============================================================================

# Project & Compose Configuration
COMPOSE_PROJECT_NAME=iaop-dev
COMPOSE_PROFILES=foundation,agent,agency,integration,workflow,observability

# Host & Public Domain Settings
IAOP_DOMAIN=dev.iaop.internal
PUBLIC_GATEWAY_PORT=80
PUBLIC_KEYCLOAK_PORT=8080
PUBLIC_POSTGRES_PORT=5432
PUBLIC_KAFKA_PORT=9092
PUBLIC_PROMETHEUS_PORT=9090

# PostgreSQL 16 Settings (Limit: 1.5 GB RAM)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_secret_change_me
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=16MB

# Keycloak 24 Settings (Limit: 1.0 GB RAM)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_secret_change_me
KEYCLOAK_DB=iaop_keycloak
KEYCLOAK_JVM_XMS=256m
KEYCLOAK_JVM_XMX=768m

# Kafka KRaft Settings (Limit: 1.0 GB RAM)
KAFKA_CLUSTER_ID=4L622nShTUiTwyvCdLfZ2w
KAFKA_JVM_OPTS=-Xmx768m -Xms256m
KAFKA_LOG_RETENTION_HOURS=48
KAFKA_LOG_SEGMENT_BYTES=104857600
KAFKA_LOG_RETENTION_BYTES=5368709120

# Cloudflare Tunnel (Optional: set token if using managed cloudflared tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_ID=iaop-dev-tunnel

# Domain Microservices Settings (Limit: 384MB - 512MB RAM each)
JWT_SECRET=dev-jwt-hmac-secret-at-least-32-chars-long-123456
CALLBACK_HMAC_SECRET=dev-webhook-hmac-sha256-secret-654321
RUST_LOG=info,iaop=debug

# Flowable OSS 7 Settings (Limit: 1.5 GB RAM)
FLOWABLE_JVM_XMS=256m
FLOWABLE_JVM_XMX=1024m

# Prometheus Retention Settings (Limit: 1.0 GB RAM, 15 GB Disk)
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=15GB

# Backup Directory
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
